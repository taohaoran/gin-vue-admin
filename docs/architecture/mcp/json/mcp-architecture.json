  "cards": [
    {
      "dot": "emerald",
      "title": "工具自注册机制",
      "items": [
        "每个工具文件 init() 调 RegisterTool(&Xxx{})",
        "McpTool 接口要求实现 New() mcp.Tool 与 Handle()",
        "NewMCPServer 启动时一次性 AddTool 全部注册工具"
      ]
    },
    {
      "dot": "cyan",
      "title": "代理而非内嵌",
      "items": [
        "MCP 工具不直接调 Service 层",
        "统一经 http_client 以带 token 的 HTTP 请求打主服务",
        "复用主服务既有 JWT+Casbin 鉴权与 RBAC"
      ]
    },
    {
      "dot": "amber",
      "title": "独立进程托管",
      "items": [
        "standalone_manager 在页面触发时 go build 并 exec cmd/mcp",
        "PID/日志/配置写入 .tmp/mcp/managed-process.json",
        "健康检查 /health，启动等待 20s，停止等待 8s"
      ]
    }
